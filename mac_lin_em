Option Explicit

Sub Send_QA_Emails_Grouped()
    Const WELL_DONE_GIF As String = "https://media.giphy.com/media/111ebonMs90YLu/giphy.gif"
    
    Dim wb As Workbook
    Dim wsQA As Worksheet, wsKeys As Worksheet, wsTemp As Worksheet
    Dim loQA As ListObject, loKeys As ListObject
    Dim olApp As Object, olMail As Object
    Dim loTmp As ListObject
    
    Dim colComp As Long, colCSA As Long, colReviewer As Long, colPF As Long
    Dim i As Long
    Dim haveDate As Boolean
    Dim dt As Date, minDate As Date, maxDate As Date
    Dim periodText As String
    Dim startDate As Date, endDate As Date
    
    Dim dictCSA As Object
    Dim key As Variant, combo As String
    
    Set wb = ThisWorkbook
    Set wsQA = wb.Worksheets("QA Sample Set")
    Set wsKeys = wb.Worksheets("Keys")
    Set loQA = wsQA.ListObjects("QA_Sam")
    Set loKeys = wsKeys.ListObjects("Em_add")
    
    '=== Identify columns ===
    colComp = GetListColumnIndex(loQA, Array("Completed Date"))
    colCSA = GetListColumnIndex(loQA, Array("Offshore CSA (Completed by)"))
    colReviewer = GetListColumnIndex(loQA, Array("Reviewer"))
    colPF = GetListColumnIndex(loQA, Array("Pass/Fail"))
    If colComp * colCSA * colReviewer * colPF = 0 Then
        MsgBox "Missing required columns in QA_Sam.", vbCritical
        Exit Sub
    End If
    
    '=== Pre-check: Ensure all names have email entries ===
    If Not ValidateEmails(loQA, loKeys, colReviewer, colCSA) Then Exit Sub
    
    '=== Determine period ===
    For i = 1 To loQA.ListRows.Count
        If IsDate(loQA.DataBodyRange.Cells(i, colComp).Value) Then
            dt = CDate(loQA.DataBodyRange.Cells(i, colComp).Value)
            If Not haveDate Then
                minDate = dt: maxDate = dt: haveDate = True
            Else
                If dt < minDate Then minDate = dt
                If dt > maxDate Then maxDate = dt
            End If
        End If
    Next i
    If haveDate Then
        periodText = Format(minDate, "mmmm yyyy")
        startDate = DateSerial(Year(minDate), Month(minDate), 1)
        endDate = DateSerial(Year(minDate), Month(minDate) + 1, 0)
    Else
        periodText = InputBox("Enter period text (e.g. September 2025):", "QA Period")
        If periodText = "" Then Exit Sub
    End If
    
    '=== Temp sheet ===
    On Error Resume Next
    Set wsTemp = wb.Worksheets("Temp_QA_Email")
    On Error GoTo 0
    If wsTemp Is Nothing Then
        Set wsTemp = wb.Worksheets.Add(After:=wsQA)
        wsTemp.Name = "Temp_QA_Email"
    Else
        wsTemp.Cells.Clear
    End If
    
    '=== Unique CSA + Pass/Fail + Reviewer ===
    Set dictCSA = CreateObject("Scripting.Dictionary")
    For i = 1 To loQA.ListRows.Count
        Dim csa As String, pf As String, rev As String
        Dim d As Variant
        csa = Trim(loQA.DataBodyRange.Cells(i, colCSA).Value)
        pf = LCase(Trim(loQA.DataBodyRange.Cells(i, colPF).Value))
        rev = Trim(loQA.DataBodyRange.Cells(i, colReviewer).Value)
        d = loQA.DataBodyRange.Cells(i, colComp).Value
        If csa <> "" And (pf = "pass" Or pf = "fail") And rev <> "" Then
            If Not haveDate Or (IsDate(d) And d >= startDate And d <= endDate) Then
                combo = csa & "|" & pf & "|" & rev
                If Not dictCSA.exists(combo) Then dictCSA.Add combo, True
            End If
        End If
    Next i
    If dictCSA.Count = 0 Then
        MsgBox "No QA records for period " & periodText, vbInformation
        Exit Sub
    End If
    
    '=== Outlook ===
    On Error Resume Next
    Set olApp = GetObject(Class:="Outlook.Application")
    If olApp Is Nothing Then Set olApp = CreateObject("Outlook.Application")
    On Error GoTo 0
    If olApp Is Nothing Then
        MsgBox "Outlook not available.", vbCritical
        Exit Sub
    End If
    
    Application.ScreenUpdating = False
    
    Dim arr As Variant, CSAName As String, PFStatus As String, ReviewerName As String
    Dim reviewerEmail As String, csaEmail As String
    Dim dataRange As Range, htmlTable As String
    Dim subj As String, bodyHTML As String
    
    For Each key In dictCSA.Keys
        arr = Split(CStr(key), "|")
        CSAName = arr(0): PFStatus = arr(1): ReviewerName = arr(2)
        reviewerEmail = GetEmailFromName(loKeys, ReviewerName)
        csaEmail = GetEmailFromName(loKeys, CSAName)
        If csaEmail = "" Then GoTo NextKey
        
        ' Filter and copy subset (with headers)
        wsTemp.Cells.Clear
        loQA.Range.AutoFilter Field:=colCSA, Criteria1:=CSAName
        loQA.Range.AutoFilter Field:=colPF, Criteria1:=IIf(PFStatus = "pass", "Pass", "Fail")
        If haveDate Then
            loQA.Range.AutoFilter Field:=colComp, _
                Criteria1:=">=" & CLng(startDate), Operator:=xlAnd, _
                Criteria2:="<=" & CLng(endDate)
        End If
        ' Include header
        loQA.Range.Rows(1).Copy wsTemp.Range("A1")
        On Error Resume Next
        loQA.DataBodyRange.SpecialCells(xlCellTypeVisible).Copy
        On Error GoTo 0
        wsTemp.Range("A2").PasteSpecial xlPasteValues
        Application.CutCopyMode = False
        loQA.AutoFilter.ShowAllData
        If wsTemp.Range("A1").CurrentRegion.Rows.Count <= 1 Then GoTo NextKey
        
        Set dataRange = wsTemp.Range("A1").CurrentRegion
        htmlTable = BuildHTMLTable(dataRange)
        
        ' Compose email
        Set olMail = olApp.CreateItem(0)
        If PFStatus = "pass" Then
            subj = "QA Results for " & periodText & " – PASSED"
            bodyHTML = "<p>Hi " & CSAName & ",</p>" & _
                       "<p>Great news! Your QA review items for <b>" & periodText & "</b> have passed successfully." & _
                       "<br>Excellent consistency and accuracy this round. Keep it going!</p>" & _
                       "<p><img src='" & WELL_DONE_GIF & "' width='200'></p>" & _
                       "<p><b>Summary of your passed items:</b></p>" & htmlTable & _
                       "<p>Regards,<br>" & ReviewerName & "</p>"
        Else
            subj = "QA Results for " & periodText & " – ACTION REQUIRED"
            bodyHTML = "<p>Hi " & CSAName & ",</p>" & _
                       "<p>The following items did not pass QA for <b>" & periodText & "</b>. " & _
                       "Please review and take corrective action.</p>" & htmlTable & _
                       "<p><b>Kindly complete the required remediation within 5 business days. " & _
                       "Once the remediation has been completed, please notify me/Reviewer so it can be confirmed and closed.</b></p>" & _
                       "<p>Regards,<br>" & ReviewerName & "</p>"
        End If
        
        With olMail
            .To = csaEmail
            If reviewerEmail <> "" Then .CC = reviewerEmail
            .Subject = subj
            .HTMLBody = bodyHTML
            '.Display   'For testing
            .Send
        End With
NextKey:
    Next key
    
    ' Delete temp sheet
    Application.DisplayAlerts = False
    On Error Resume Next
    wsTemp.Delete
    On Error GoTo 0
    Application.DisplayAlerts = True
    
    Application.ScreenUpdating = True
    MsgBox "Grouped QA emails sent for " & periodText, vbInformation
End Sub

'=========== PRE-RUN CHECK: Ensure all emails exist ===========
Private Function ValidateEmails(loQA As ListObject, loKeys As ListObject, colReviewer As Long, colCSA As Long) As Boolean
    Dim dict As Object, nm As String
    Dim i As Long, lr As Long
    Set dict = CreateObject("Scripting.Dictionary")
    
    ' Collect all names from QA
    For i = 1 To loQA.ListRows.Count
        nm = Trim(loQA.DataBodyRange.Cells(i, colReviewer).Value)
        If nm <> "" Then dict(nm) = 1
        nm = Trim(loQA.DataBodyRange.Cells(i, colCSA).Value)
        If nm <> "" Then dict(nm) = 1
    Next i
    
    ' Collect existing names from Keys
    Dim existing As Object
    Set existing = CreateObject("Scripting.Dictionary")
    Dim r As Range
    For Each r In loKeys.ListColumns("Name").DataBodyRange
        If Trim(r.Value) <> "" Then existing(Trim(r.Value)) = 1
    Next r
    
    ' Find missing names
    Dim missing As Collection
    Set missing = New Collection
    Dim k As Variant
    For Each k In dict.Keys
        If Not existing.exists(k) Then missing.Add k
    Next k
    
    ' If missing, append and stop
    If missing.Count > 0 Then
        lr = loKeys.ListRows.Count
        Dim nmMiss As Variant
        For Each nmMiss In missing
            loKeys.ListRows.Add
            loKeys.DataBodyRange.Cells(lr + 1, 1).Value = nmMiss
            lr = lr + 1
        Next nmMiss
        MsgBox "New names added to Keys!Em_add: please fill email addresses and rerun the macro.", vbExclamation
        ValidateEmails = False
        Exit Function
    End If
    ValidateEmails = True
End Function

'=========== BUILD HTML TABLE (with headers) ===========
Private Function BuildHTMLTable(rng As Range) As String
    Dim r As Long, c As Long, s As String
    Dim rows As Long, cols As Long, cellVal As String
    rows = rng.Rows.Count
    cols = rng.Columns.Count
    
    s = "<table border='1' cellspacing='0' cellpadding='4' style='border-collapse:collapse;font-family:Calibri;font-size:11pt;'>"
    ' Header row
    s = s & "<tr style='background-color:#4472C4;color:white;'>"
    For c = 1 To cols
        s = s & "<th>" & rng.Cells(1, c).Value & "</th>"
    Next c
    s = s & "</tr>"
    
    ' Data rows
    For r = 2 To rows
        If r Mod 2 = 0 Then
            s = s & "<tr style='background-color:#F2F2F2;'>"
        Else
            s = s & "<tr>"
        End If
        For c = 1 To cols
            cellVal = rng.Cells(r, c).Text
            s = s & "<td>" & cellVal & "</td>"
        Next c
        s = s & "</tr>"
    Next r
    s = s & "</table>"
    BuildHTMLTable = s
End Function

'=========== HELPER FUNCTIONS ===========
Private Function GetEmailFromName(lo As ListObject, personName As String) As String
    Dim r As Range
    On Error Resume Next
    Set r = lo.ListColumns("Name").DataBodyRange.Find(What:=personName, LookIn:=xlValues, LookAt:=xlWhole)
    On Error GoTo 0
    If Not r Is Nothing Then GetEmailFromName = Trim(r.Offset(0, 1).Value)
End Function

Private Function GetListColumnIndex(lo As ListObject, names As Variant) As Long
    Dim lc As ListColumn, nm As Variant
    For Each nm In names
        For Each lc In lo.ListColumns
            If StrComp(Trim(lc.Name), Trim(CStr(nm)), vbTextCompare) = 0 Then
                GetListColumnIndex = lc.Index
                Exit Function
            End If
        Next lc
    Next nm
End Function