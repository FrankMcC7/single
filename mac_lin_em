Option Explicit
'====================================================================================
'  MACRO NAME:   Send_QA_Emails_Grouped   (UPDATED – ROW-WISE VERSION + DIAGNOSTICS)
'====================================================================================
'  PURPOSE
'    • Before running, ensures QA_Sam[Reviewer] is filtered so that only ONE unique
'      reviewer value is visible. If not, prompts the user to filter to their name
'      and exits.
'    • For the selected period, sends ONE email PER VISIBLE ROW in QA_Sam.
'    • Email is sent FROM the current Outlook user.
'    • "To"   = email of Offshore CSA (Completed by) from Keys!Em_add.
'    • "CC"   = email of Reviewer for that row from Keys!Em_add.
'    • Subject and body template depend on value in "Pass/Fail" (Pass vs Fail).
'    • Each email contains a small HTML table with just that single QA record.
'
'  TOGGLE DISPLAY vs SEND
'    Const PREVIEW_MODE As Boolean = True  → .Display (preview only)
'    Const PREVIEW_MODE As Boolean = False → .Send    (actually sends)
'
'  HARD STOP VALIDATIONS
'    1) QA_Sam must have at least one data row.
'    2) QA_Sam[Reviewer] must have exactly ONE unique visible value.
'    3) Keys!Em_add must contain all Reviewer & CSA names (otherwise names are
'       appended and macro stops for you to fill emails).
'    4) For visible rows in scope:
'         - "Pass/Fail" is MANDATORY.
'         - If any visible row has blank "Pass/Fail", macro stops and tells you.
'
'  INPUT
'    Sheet: "QA Sample Set"    → Table: "QA_Sam" (ListObject)
'      Required columns (case-insensitive):
'        - "Completed Date"
'        - "Pass/Fail"
'        - "Reviewer"
'        - "Offshore CSA (Completed by)"  (or "Offshore CSA")
'
'    Sheet: "Keys"            → Table: "Em_add"
'      Required columns:
'        - "Name"
'        - "Email address"
'
'  PERIOD LOGIC
'    • Uses earliest Completed Date among visible rows with nonblank Pass/Fail.
'    • That defines the period month (e.g., "September 2025") and the date window.
'    • If it can’t find any valid date, asks you to type the period text manually;
'      in that case, it does NOT date-filter; it just uses currently visible rows.
'
'====================================================================================

Sub Send_QA_Emails_Grouped()
    Const PREVIEW_MODE As Boolean = False
    Const WELL_DONE_GIF As String = "https://media.giphy.com/media/111ebonMs90YLu/giphy.gif"
    
    Dim wb As Workbook
    Dim wsQA As Worksheet, wsKeys As Worksheet, wsTemp As Worksheet
    Dim loQA As ListObject, loKeys As ListObject
    Dim loTmp As ListObject
    
    Dim colComp As Long, colCSA As Long, colRev As Long, colPF As Long
    Dim i As Long, haveDate As Boolean
    Dim dt As Date, minDate As Date
    Dim periodText As String, startDate As Date, endDate As Date
    
    Dim uniqueRevCount As Long
    Dim rngDB As Range
    
    Dim blankPFCount As Long
    Dim candidateRows As Collection
    Dim rowIdx As Long
    Dim pfStatus As String
    Dim dtRow As Variant
    
    Dim olApp As Object, olMail As Object
    Dim wsTempCreated As Boolean
    
    Dim k As Long
    Dim thisRow As Long
    Dim csaName As String, reviewerName As String
    Dim toEmail As String, ccEmail As String
    Dim subj As String, bodyHTML As String
    Dim dataRange As Range, htmlTable As String
    Dim pfLower As String
    Dim sentCount As Long
    
    '--- Basic workbook/table setup ---
    Set wb = ThisWorkbook
    
    On Error Resume Next
    Set wsQA = wb.Worksheets("QA Sample Set")
    On Error GoTo 0
    If wsQA Is Nothing Then
        MsgBox "Sheet 'QA Sample Set' not found. Cannot proceed.", vbCritical
        Exit Sub
    End If
    
    On Error Resume Next
    Set wsKeys = wb.Worksheets("Keys")
    On Error GoTo 0
    If wsKeys Is Nothing Then
        MsgBox "Sheet 'Keys' not found. Cannot proceed.", vbCritical
        Exit Sub
    End If
    
    On Error Resume Next
    Set loQA = wsQA.ListObjects("QA_Sam")
    On Error GoTo 0
    If loQA Is Nothing Then
        MsgBox "Table 'QA_Sam' not found on sheet 'QA Sample Set'.", vbCritical
        Exit Sub
    End If
    
    On Error Resume Next
    Set loKeys = wsKeys.ListObjects("Em_add")
    On Error GoTo 0
    If loKeys Is Nothing Then
        MsgBox "Table 'Em_add' not found on sheet 'Keys'.", vbCritical
        Exit Sub
    End If
    
    If loQA.DataBodyRange Is Nothing Then
        MsgBox "QA_Sam has no data rows. Nothing to send.", vbExclamation
        Exit Sub
    End If
    Set rngDB = loQA.DataBodyRange
    
    '--- Get required column indexes ---
    colComp = GetListColumnIndex(loQA, Array("Completed Date"))
    colCSA  = GetListColumnIndex(loQA, Array("Offshore CSA (Completed by)", "Offshore CSA"))
    colRev  = GetListColumnIndex(loQA, Array("Reviewer"))
    colPF   = GetListColumnIndex(loQA, Array("Pass/Fail"))
    
    If colComp * colCSA * colRev * colPF = 0 Then
        MsgBox "One or more required columns not found in QA_Sam:" & vbCrLf & _
               " - Completed Date" & vbCrLf & _
               " - Pass/Fail" & vbCrLf & _
               " - Reviewer" & vbCrLf & _
               " - Offshore CSA (Completed by)", vbCritical
        Exit Sub
    End If
    
    '--------------------------------------------------------------------------------
    ' STEP 1: Reviewer filter check → must have EXACTLY ONE unique visible reviewer
    '--------------------------------------------------------------------------------
    uniqueRevCount = CountUniqueVisibleValues(loQA, colRev)
    If uniqueRevCount = 0 Then
        MsgBox "No visible rows found in QA_Sam. Check your filters.", vbExclamation
        Exit Sub
    ElseIf uniqueRevCount <> 1 Then
        MsgBox "Reviewer filter check failed." & vbCrLf & _
               "The 'Reviewer' column in QA_Sam must be filtered so that only ONE reviewer " & _
               "is visible (your name) before running this macro.", vbExclamation
        Exit Sub
    End If
    
    '--------------------------------------------------------------------------------
    ' STEP 2: Validate email mappings (Keys!Em_add)
    '--------------------------------------------------------------------------------
    If Not ValidateEmails_Map(loQA, loKeys, colRev, colCSA) Then
        ' ValidateEmails_Map already showed a message and appended any missing names.
        Exit Sub
    End If
    
    '--------------------------------------------------------------------------------
    ' STEP 3: Determine period from Completed Date (earliest month with nonblank Pass/Fail)
    '         Only considers VISIBLE rows.
    '--------------------------------------------------------------------------------
    haveDate = False
    For i = 1 To loQA.ListRows.Count
        If Not rngDB.Rows(i).EntireRow.Hidden Then
            If Trim$(rngDB.Cells(i, colPF).Value) <> "" Then
                If IsDate(rngDB.Cells(i, colComp).Value) Then
                    dt = CDate(rngDB.Cells(i, colComp).Value)
                    If Not haveDate Then
                        minDate = dt
                        haveDate = True
                    ElseIf dt < minDate Then
                        minDate = dt
                    End If
                End If
            End If
        End If
    Next i
    
    If haveDate Then
        periodText = Format(minDate, "mmmm yyyy")
        startDate = DateSerial(Year(minDate), Month(minDate), 1)
        endDate   = DateSerial(Year(minDate), Month(minDate) + 1, 0)
    Else
        periodText = InputBox("Could not detect the QA period from 'Completed Date'." & vbCrLf & _
                              "Please type the period text (e.g. ""September 2025"":", _
                              "QA Period")
        If Trim$(periodText) = "" Then
            MsgBox "No period entered. Macro cancelled.", vbExclamation
            Exit Sub
        End If
        ' When user types free text, we do not date-filter. We just use visible rows.
        startDate = 0
        endDate = 0
    End If
    
    '--------------------------------------------------------------------------------
    ' STEP 4: Build candidate row list and enforce mandatory Pass/Fail
    '--------------------------------------------------------------------------------
    Set candidateRows = New Collection
    blankPFCount = 0
    
    For i = 1 To loQA.ListRows.Count
        ' Respect current filters (especially Reviewer filter)
        If Not rngDB.Rows(i).EntireRow.Hidden Then
            
            dtRow = rngDB.Cells(i, colComp).Value
            
            ' If we have a concrete month, restrict to that month; otherwise include all visible rows
            If startDate <> 0 Then
                If IsDate(dtRow) Then
                    dt = CDate(dtRow)
                    If dt < startDate Or dt > endDate Then
                        GoTo NextVisibleRow
                    End If
                Else
                    ' No valid date → ignore this row in this run
                    GoTo NextVisibleRow
                End If
            End If
            
            pfStatus = Trim$(CStr(rngDB.Cells(i, colPF).Value))
            
            If pfStatus = "" Then
                blankPFCount = blankPFCount + 1
            Else
                candidateRows.Add i
            End If
        End If
NextVisibleRow:
    Next i
    
    If blankPFCount > 0 Then
        MsgBox "Column 'Pass/Fail' is MANDATORY for all visible rows in the current scope." & vbCrLf & _
               "There are " & blankPFCount & " visible row(s) with blank 'Pass/Fail'." & vbCrLf & _
               "Please populate 'Pass' or 'Fail' for those rows and rerun the macro.", _
               vbCritical
        Exit Sub
    End If
    
    If candidateRows.Count = 0 Then
        MsgBox "No QA records with populated 'Pass/Fail' found for period " & periodText & _
               " within the currently visible rows.", vbInformation
        Exit Sub
    End If
    
    '--------------------------------------------------------------------------------
    ' STEP 5: Prepare / clear temp sheet for building one-row tables
    '--------------------------------------------------------------------------------
    On Error Resume Next
    Set wsTemp = wb.Worksheets("Temp_QA_Email")
    On Error GoTo 0
    If wsTemp Is Nothing Then
        Set wsTemp = wb.Worksheets.Add(After:=wsQA)
        wsTemp.Name = "Temp_QA_Email"
        wsTempCreated = True
    Else
        wsTemp.Cells.Clear
        On Error Resume Next
        For Each loTmp In wsTemp.ListObjects
            loTmp.Delete
        Next loTmp
        On Error GoTo 0
        wsTempCreated = True
    End If
    
    '--------------------------------------------------------------------------------
    ' STEP 6: Set up Outlook
    '--------------------------------------------------------------------------------
    On Error Resume Next
    Set olApp = GetObject(Class:="Outlook.Application")
    If olApp Is Nothing Then Set olApp = CreateObject("Outlook.Application")
    On Error GoTo 0
    If olApp Is Nothing Then
        MsgBox "Outlook is not available. Cannot create or send emails.", vbCritical
        GoTo TidyUp
    End If
    
    Application.ScreenUpdating = False
    sentCount = 0
    
    '--------------------------------------------------------------------------------
    ' STEP 7: Loop through candidate rows and send one email per row
    '--------------------------------------------------------------------------------
    For k = 1 To candidateRows.Count
        thisRow = candidateRows(k)
        
        csaName = Trim$(rngDB.Cells(thisRow, colCSA).Value)
        reviewerName = Trim$(rngDB.Cells(thisRow, colRev).Value)
        pfStatus = Trim$(CStr(rngDB.Cells(thisRow, colPF).Value))
        pfLower = LCase$(pfStatus)
        
        ' Resolve emails (To and CC)
        toEmail = GetEmailFromName(loKeys, csaName)
        ccEmail = GetEmailFromName(loKeys, reviewerName)
        
        If Len(toEmail) = 0 Then
            ' Should not happen if ValidateEmails_Map was satisfied
            MsgBox "No email address found for CSA name '" & csaName & "'. Skipping that row.", _
                   vbExclamation
            GoTo NextRowToSend
        End If
        
        ' Build one-row HTML table in Temp sheet
        wsTemp.Cells.Clear
        loQA.HeaderRowRange.Copy wsTemp.Range("A1")
        rngDB.Rows(thisRow).Copy wsTemp.Range("A2")
        
        Set dataRange = wsTemp.Range("A1").CurrentRegion
        htmlTable = BuildHTMLTable_ForEmail(dataRange)
        
        ' Compose email
        Set olMail = olApp.CreateItem(0)
        
        If pfLower = "pass" Then
            subj = "QA Results for " & periodText & " – PASSED"
            bodyHTML = "<p>Hi " & EncodeHtml(csaName) & ",</p>" & _
                       "<p>Great news! The following QA item for <b>" & EncodeHtml(periodText) & _
                       "</b> has passed successfully." & _
                       "<br>Excellent consistency and attention to detail.</p>" & _
                       "<p><img src='" & WELL_DONE_GIF & "' width='200'></p>" & _
                       "<p><b>Details of the passed item:</b></p>" & htmlTable & _
                       "<p>Regards,<br>" & EncodeHtml(reviewerName) & "</p>"
        ElseIf pfLower = "fail" Then
            subj = "QA Results for " & periodText & " – ACTION REQUIRED"
            bodyHTML = "<p>Hi " & EncodeHtml(csaName) & ",</p>" & _
                       "<p>The QA item below did not pass QA for <b>" & EncodeHtml(periodText) & "</b>. " & _
                       "Please review the details and address the issues.</p>" & _
                       htmlTable & _
                       "<p><b>Kindly complete the required remediation within 5 business days. " & _
                       "Once remediation is completed, please notify the reviewer so it can be confirmed and closed.</b></p>" & _
                       "<p>Regards,<br>" & EncodeHtml(reviewerName) & "</p>"
        Else
            ' Should not happen due to earlier mandatory Pass/Fail check
            MsgBox "Unexpected Pass/Fail value '" & pfStatus & "' on row " & thisRow & _
                   ". Skipping this row.", vbExclamation
            GoTo NextRowToSend
        End If
        
        With olMail
            .To = toEmail
            If Len(ccEmail) > 0 Then .CC = ccEmail
            .Subject = subj
            .HTMLBody = bodyHTML
            If PREVIEW_MODE Then
                .Display
            Else
                .Send
            End If
        End With
        
        sentCount = sentCount + 1
        
NextRowToSend:
    Next k
    
TidyUp:
    ' Clean up temp sheet (do not error if user deleted it manually)
    On Error Resume Next
    If wsTempCreated Then
        Application.DisplayAlerts = False
        wsTemp.Delete
        Application.DisplayAlerts = True
    End If
    On Error GoTo 0
    
    Application.ScreenUpdating = True
    
    MsgBox "Macro completed for period: " & periodText & vbCrLf & _
           "Total candidate rows with Pass/Fail: " & candidateRows.Count & vbCrLf & _
           "Total emails processed (displayed/sent): " & sentCount, vbInformation
End Sub

'===============================
' Helpers
'===============================

' Count unique visible values in a given ListObject column (DataBodyRange only)
Private Function CountUniqueVisibleValues(lo As ListObject, colIndex As Long) As Long
    Dim dict As Object
    Dim rngCol As Range, cell As Range
    
    If lo.DataBodyRange Is Nothing Then
        CountUniqueVisibleValues = 0
        Exit Function
    End If
    
    Set dict = CreateObject("Scripting.Dictionary")
    Set rngCol = lo.DataBodyRange.Columns(colIndex)
    
    On Error Resume Next
    For Each cell In rngCol.SpecialCells(xlCellTypeVisible)
        If Trim$(CStr(cell.Value)) <> "" Then
            If Not dict.Exists(Trim$(CStr(cell.Value))) Then
                dict.Add Trim$(CStr(cell.Value)), 1
            End If
        End If
    Next cell
    On Error GoTo 0
    
    CountUniqueVisibleValues = dict.Count
End Function

' Get email by exact Name match from Em_add
Private Function GetEmailFromName(lo As ListObject, personName As String) As String
    Dim r As Range
    On Error Resume Next
    Set r = lo.ListColumns("Name").DataBodyRange.Find(What:=personName, LookIn:=xlValues, LookAt:=xlWhole)
    On Error GoTo 0
    If Not r Is Nothing Then GetEmailFromName = Trim$(r.Offset(0, 1).Value)
End Function

' Ensure Keys!Em_add has all names; append missing and stop to let user fill emails
Private Function ValidateEmails_Map(loQA As ListObject, loKeys As ListObject, _
                                    colRev As Long, colCSA As Long) As Boolean
    Dim dictAll As Object, dictExisting As Object
    Dim i As Long, nm As String, r As Range, lr As Long
    
    Set dictAll = CreateObject("Scripting.Dictionary")
    Set dictExisting = CreateObject("Scripting.Dictionary")
    
    ' Collect all names from QA (Reviewer + CSA, all rows)
    For i = 1 To loQA.ListRows.Count
        nm = Trim$(loQA.DataBodyRange.Cells(i, colRev).Value)
        If nm <> "" Then dictAll(nm) = 1
        nm = Trim$(loQA.DataBodyRange.Cells(i, colCSA).Value)
        If nm <> "" Then dictAll(nm) = 1
    Next i
    
    ' Existing names in Em_add
    For Each r In loKeys.ListColumns("Name").DataBodyRange
        If Trim$(r.Value) <> "" Then dictExisting(Trim$(r.Value)) = 1
    Next r
    
    ' Append missing names
    Dim missing As New Collection, k As Variant
    For Each k In dictAll.Keys
        If Not dictExisting.Exists(CStr(k)) Then missing.Add CStr(k)
    Next k
    
    If missing.Count > 0 Then
        lr = loKeys.ListRows.Count
        For Each k In missing
            loKeys.ListRows.Add
            loKeys.DataBodyRange.Cells(lr + 1, 1).Value = k
            lr = lr + 1
        Next k
        MsgBox "New names were appended to Keys!Em_add (Name column only)." & vbCrLf & _
               "Please fill their email addresses in 'Email address' column and rerun.", _
               vbExclamation
        ValidateEmails_Map = False
        Exit Function
    End If
    
    ValidateEmails_Map = True
End Function

' Build HTML table for the email body with headers + formatting rules
Private Function BuildHTMLTable_ForEmail(rng As Range) As String
    Dim r As Long, c As Long, rows As Long, cols As Long
    Dim s As String, cellVal As Variant, colName As String
    
    rows = rng.Rows.Count
    cols = rng.Columns.Count
    
    s = "<table border='1' cellspacing='0' cellpadding='4' " & _
        "style='border-collapse:collapse;font-family:Calibri;font-size:11pt;width:auto;'>"
    
    ' Header
    s = s & "<tr style='background-color:#4472C4;color:white;'>"
    For c = 1 To cols
        s = s & "<th style='white-space:nowrap;text-align:left;padding:4px;'>" & _
                EncodeHtml(rng.Cells(1, c).Value) & "</th>"
    Next c
    s = s & "</tr>"
    
    ' Body
    For r = 2 To rows
        s = s & IIf(r Mod 2 = 0, "<tr style='background-color:#F2F2F2;'>", "<tr>")
        For c = 1 To cols
            colName = LCase$(Trim$(CStr(rng.Cells(1, c).Value)))
            cellVal = rng.Cells(r, c).Value
            
            ' Date columns → mm/dd/yyyy (handles serials too)
            If InStr(colName, "completed date") > 0 Or InStr(colName, "date reviewed") > 0 Then
                If IsDate(cellVal) Then
                    cellVal = Format$(CDate(cellVal), "mm/dd/yyyy")
                ElseIf IsNumeric(cellVal) And cellVal > 30000 And cellVal < 60000 Then
                    cellVal = Format$(CDate(cellVal), "mm/dd/yyyy")
                End If
            ' Numerics (e.g., long IDs) → force plain text to avoid scientific notation
            ElseIf IsNumeric(cellVal) Then
                cellVal = CStr(cellVal)
            End If
            
            s = s & "<td style='white-space:nowrap;text-align:left;padding:4px;'>" & _
                    EncodeHtml(cellVal) & "</td>"
        Next c
        s = s & "</tr>"
    Next r
    
    s = s & "</table>"
    BuildHTMLTable_ForEmail = s
End Function

' Basic HTML encoding for cell content
Private Function EncodeHtml(v As Variant) As String
    Dim t As String
    t = CStr(v)
    t = Replace(t, "&", "&amp;")
    t = Replace(t, "<", "&lt;")
    t = Replace(t, ">", "&gt;")
    t = Replace(t, """", "&quot;")
    EncodeHtml = t
End Function

' Return index of a header in a ListObject by trying multiple header candidates
Private Function GetListColumnIndex(lo As ListObject, names As Variant) As Long
    Dim lc As ListColumn, nm As Variant
    For Each nm In names
        For Each lc In lo.ListColumns
            If StrComp(Trim$(CStr(lc.Name)), Trim$(CStr(nm)), vbTextCompare) = 0 Then
                GetListColumnIndex = lc.Index
                Exit Function
            End If
        Next lc
    Next nm
    GetListColumnIndex = 0
End Function